{
  "name": "oc-agent-plugins",
  "version": "0.2.2",
  "description": "Load Agent Plugins, Claude Code, Codex and Cursor packages in OpenCode v2, with skills, agents, MCP servers, commands, rules, opt-in hooks and monitors, and output styles.",
  "keywords": [
    "agent-plugins",
    "mcp",
    "opencode",
    "opencode-plugin",
    "skills"
  ],
  "homepage": "https://github.com/theacrat/oc-agent-plugins#readme",
  "bugs": {
    "url": "https://github.com/theacrat/oc-agent-plugins/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theacrat/oc-agent-plugins.git"
  },
  "bin": {
    "oc-agent-plugins": "./dist/cli.js"
  },
  "files": [
    "src",
    "index.ts",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun scripts/build-cli.ts",
    "check": "bun run lint && bun run fmt:check && bun run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "inspect": "bun scripts/inspect.ts",
    "lint": "oxlint",
    "prepack": "bun run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.24",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@types/bun": "1.4.2",
    "lefthook": "^2.1.16",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
